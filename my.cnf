#
# These groups are read by MariaDB server.
# Use it for options that only the server (but not clients) should see

# this is read by the standalone daemon and embedded servers
[server]

# this is only for the mysqld standalone daemon
[mysqld]

# ==========================================
# Core System Settings
# ==========================================
pid-file                            = /run/mysqld/mysqld.pid
basedir                             = /usr
bind-address                        = 127.0.0.1
symbolic-links                      = 0
skip_external_locking                            # Prevents system-level locking for better performance
skip-name-resolve                                # Speeds up connection establishment (DNS resolution disabled)
skip_name_resolve                   = 1          # (Duplicate parameter ensuring DNS skips)

# ==========================================
# Character Set & Collation
# ==========================================
character-set-server                = utf8mb4    # Modern standard for storing emojis/special chars
collation-server                    = utf8mb4_general_ci

# ==========================================
# Connection & Network Limits
# ==========================================
max_connections                     = 80         # Safe limit to prevent OOM on 8GB RAM
max_allowed_packet                  = 64M        # Large enough for heavy 1C XML payloads

# ==========================================
# Timeouts (Optimized for 1C Imports)
# ==========================================
interactive_timeout                 = 600        # Allows 10-minute idle connections
wait_timeout                        = 600        # Allows 10-minute idle connections
net_read_timeout                    = 120        # Prevents "Got an error reading communication packets"
net_write_timeout                   = 120        # Gives PHP scripts enough time to respond

# ==========================================
# InnoDB Memory & I/O Tuning
# ==========================================
innodb_buffer_pool_size             = 3584M      # Keeps DB in RAM while leaving space for OS/PHP (prevents crashes)
innodb_log_file_size                = 1G         # Sized for fast crash recovery
innodb_log_buffer_size              = 16M
innodb_flush_log_at_trx_commit      = 2          # Massive speedup for 1C bulk INSERTs/UPDATEs
innodb_flush_method                 = O_DIRECT   # Bypasses OS cache to prevent double-buffering

# ==========================================
# Thread Buffers (Per-Connection Variables)
# ==========================================
key_buffer_size                     = 16M
join_buffer_size                    = 2M         # Kept low to stop RAM exhaustion on unindexed joins
sort_buffer_size                    = 2M
read_buffer_size                    = 2M
read_rnd_buffer_size                = 1M

# ==========================================
# Table & File Descriptor Caches
# ==========================================
table_definition_cache              = 2000       # Covers all 1,100+ PrestaShop tables
table_open_cache                    = 2000       # Prevents high disk I/O from cache evictions
open_files_limit                    = 10000      # OS-level file handles limit
tmp_table_size                      = 64M        # Keeps temporary tables in fast RAM
max_heap_table_size                 = 64M        # Matches tmp_table_size

# ==========================================
# Query Cache (Enabled for Frontend Speed)
# ==========================================
query_cache_type                    = 1          # Crucial for PrestaShop 1.7 frontend performance
query_cache_size                    = 64M
query_cache_limit                   = 2M         # Max size of a single cached query result

# ==========================================
# Optimizer Settings (PrestaShop Fixes)
# ==========================================
optimizer_switch                    = 'rowid_filter=off' # Fixes 10.6+ bug causing PS 1.7 full table scans
optimizer_use_condition_selectivity = 1                  # Reverts to traditional query path planning

# ==========================================
# Logging & Diagnostics
# ==========================================
log_error                           = /var/log/mysql/mysql_error.log
performance_schema                  = OFF        # Disabled to free up server RAM
innodb_print_all_deadlocks          = 1          # Prints deadlocks to the error log for easier debugging

# --- Slow Query Logging ---
# (Currently disabled for production speed)
slow_query_log                      = 0
slow_query_log_file                 = /var/log/mysql/mysql_slow.log
long_query_time                     = 5          # Only logs queries taking longer than 5 seconds
log_queries_not_using_indexes       = 1          # Logs fast queries if they scan full tables


# this is only for embedded server
[embedded]

# This group is only read by MariaDB servers, not by MySQL.
# If you use the same .cnf file for MySQL and MariaDB,
# you can put MariaDB-only options here
[mariadb]

# This group is only read by MariaDB-10.11 servers.
# If you use the same .cnf file for MariaDB of different versions,
# use this group for options that older servers don't understand
[mariadb-10.11]